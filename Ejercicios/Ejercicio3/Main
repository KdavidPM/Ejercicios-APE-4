public class Ejercicio3 {
    public static void main(String[] args) {
        Producto p = new Producto("Cuaderno", 2.50, 10);
        p.mostrarProducto();
 
        // Venta valida
        Venta venta1 = new Venta(4);
        venta1.aplicar(p);
        p.mostrarProducto();
 
        // Venta que falla (se piden mas de los que hay)
        Venta venta2 = new Venta(20);
        venta2.aplicar(p);
        p.mostrarProducto();
    }
}
