public class Ejercicio1 {
    public static void main(String[] args) {
        // Se crean los autores
        Autor autor1 = new Autor("Gabriel Garcia Marquez", "Colombiana");
        Autor autor2 = new Autor("Jorge Icaza", "Ecuatoriana");
 
        // Se crean los libros, cada uno con su autor
        Libro libro1 = new Libro("Cien anios de soledad", 1967, autor1);
        Libro libro2 = new Libro("Huasipungo", 1934, autor2);
 
        // Se muestra la informacion
        libro1.mostrarInformacion();
        libro2.mostrarInformacion();
    }
}
