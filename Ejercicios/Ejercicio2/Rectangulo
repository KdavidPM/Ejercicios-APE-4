class Rectangulo {
    // Atributos
    private double base;
    private double altura;
 
    // Constructor
    public Rectangulo(double base, double altura) {
        this.base = base;
        this.altura = altura;
    }
 
    // Devuelve un double: el area
    public double calcularArea() {
        return base * altura;
    }
 
    // Devuelve un double: el perimetro
    public double calcularPerimetro() {
        return 2 * (base + altura);
    }
 
    // Devuelve un boolean: true si base y altura son iguales
    public boolean esCuadrado() {
        return base == altura;
    }
 
    // Devuelve un String con la descripcion
    public String obtenerDescripcion() {
        return "Rectangulo de " + base + " x " + altura;
    }
 
    // No devuelve nada (void): solo imprime los resultados
    public void mostrar() {
        System.out.println(obtenerDescripcion());
        System.out.println("Area: " + calcularArea());
        System.out.println("Perimetro: " + calcularPerimetro());
        System.out.println("Es cuadrado: " + esCuadrado());
        System.out.println("-----------------------------");
    }
}
 
